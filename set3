
abstract class Shape {
    int a, b;

    abstract void printArea();
}

class Rectangle extends Shape {
    Rectangle(int l, int w) {
        a = l;
        b = w;
    }

    void printArea() {
        System.out.println("Rectangle Area: " + (a * b));
    }
}

class Triangle extends Shape {
    Triangle(int base, int height) {
        a = base;
        b = height;
    }

    void printArea() {
        System.out.println("Triangle Area: " + (0.5 * a * b));
    }
}

class Circle extends Shape {
    Circle(int r) {
        a = r;
    }

    void printArea() {
        System.out.println("Circle Area: " + (3.14 * a * a));
    }
}

public class Main {
    public static void main(String[] args) {

        Rectangle r = new Rectangle(10, 5);
        Triangle t = new Triangle(10, 5);
        Circle c = new Circle(7);

        r.printArea();
        t.printArea();
        c.printArea();
    }
}





interface CurrencyConverter
{
    double USD_TO_INR = 95.5;
    double EURO_TO_INR = 112.8;
    double YEN_TO_INR = 0.55;

    double dollarToInr(double dollar);
    double euroToInr(double euro);
    double yenToInr(double yen);
}

class SimpleConverter implements CurrencyConverter
{
   @Override
    public double dollarToInr(double dollar) {
        return dollar * USD_TO_INR;
        
    }

    @Override
    public double euroToInr(double euro) {
       return euro * EURO_TO_INR;
    }

    @Override
    public double yenToInr(double yen) {
        return yen * YEN_TO_INR;
    }
}



public class Main
{
    public static void main(String[] args) 
    {
        SimpleConverter s = new SimpleConverter();
        double dollar = 45;
        double euro = 100.56;
        double yen = 6000;

        System.out.printf("%.2f dollars in the Inr is %.2f\n",dollar,s.dollarToInr(dollar));
        System.out.printf("%.2f euros in the Inr is %.2f\n",euro,s.euroToInr(euro));
        System.out.printf("%.2f yen in the Inr is %.2f\n",yen,s.yenToInr(yen));
        
    }
}
   
